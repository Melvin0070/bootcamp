# FossilRAG configuration. Copy to .env (gitignored) and adjust.
# Every var is read by pydantic-settings; the FOSSILRAG_ prefix is required
# except for DATABASE_URL, which is also read unprefixed.

# --- Datastore -------------------------------------------------------------
DATABASE_URL=postgresql://fossilrag:fossilrag@localhost:5432/fossilrag
FOSSILRAG_POOL_MIN_SIZE=2
FOSSILRAG_POOL_MAX_SIZE=10
FOSSILRAG_COMMAND_TIMEOUT_SEC=10.0

# --- Embeddings ------------------------------------------------------------
# Provider: mock (default, $0, deterministic) | local (sentence-transformers) | bedrock (Titan v2).
# Switching provider changes the vector space -> re-embed into a new layer.
# bedrock requires FOSSILRAG_EMBED_DIM in {256,512,1024} (Titan v2).
FOSSILRAG_EMBED_PROVIDER=mock
FOSSILRAG_EMBED_MODEL=mock-deterministic-v1
# 384 matches the local sentence-transformers fallback (all-MiniLM-L6-v2).
# Bedrock Titan v2 uses 1024 and is provisioned as its own fossil layer.
FOSSILRAG_EMBED_DIM=384

# --- Vector search ---------------------------------------------------------
FOSSILRAG_VECTOR_TABLE=fossil_chunks
FOSSILRAG_HNSW_EF_SEARCH=100

# --- Ingestion / AWS -------------------------------------------------------
FOSSILRAG_AWS_REGION=us-east-1
# Point every boto3 client at LocalStack (the `aws` compose profile sets this
# automatically). boto3 honours the unprefixed AWS_ENDPOINT_URL globally, so
# one var redirects S3 + SQS + DynamoDB at once. Tests use moto and need none
# of this.
# AWS_ENDPOINT_URL=http://localhost:4566
# Medallion buckets (raw -> silver -> gold).
FOSSILRAG_RAW_BUCKET=fossilrag-raw
FOSSILRAG_SILVER_BUCKET=fossilrag-silver
FOSSILRAG_GOLD_BUCKET=fossilrag-gold
FOSSILRAG_SILVER_PREFIX=silver

# --- SQS ingestion worker (raw -> SQS -> worker -> silver) -----------------
FOSSILRAG_INGEST_QUEUE=fossilrag-ingest
FOSSILRAG_INGEST_DLQ=fossilrag-ingest-dlq
FOSSILRAG_SQS_MAX_RECEIVE_COUNT=5
FOSSILRAG_SQS_WAIT_SECONDS=10
FOSSILRAG_SQS_MAX_MESSAGES=10

# --- LocalStack (the `aws` compose profile only) ---------------------------
# Required since LocalStack 2026.03 — even the free Hobby tier needs an account
# token (free for students/OSS at app.localstack.cloud). CI does NOT run
# LocalStack: the same logic is covered by moto. Leave blank for `docker
# compose config` to validate; set it before `make up-aws`.
# LOCALSTACK_AUTH_TOKEN=
# LOCALSTACK_IMAGE=localstack/localstack:latest   # pin a version in real use

# --- Idempotency (Self-Healing Idempotency mutation) -----------------------
# null (default, no skip) | local (JSON file) | dynamodb (atomic, cloud).
FOSSILRAG_IDEMPOTENCY_BACKEND=null
# FOSSILRAG_IDEMPOTENCY_TABLE=fossilrag-idempotency   # required for dynamodb
FOSSILRAG_IDEMPOTENCY_MANIFEST_PATH=./.fossilrag/idempotency.json

# --- LLM (/mutate) ---------------------------------------------------------
# mock (default, $0) | bedrock (Converse API) | anthropic (Messages API).
FOSSILRAG_LLM_PROVIDER=mock
# Bedrock: a cross-region inference profile id (not the bare foundation id).
FOSSILRAG_LLM_MODEL=us.anthropic.claude-sonnet-4-6
FOSSILRAG_ANTHROPIC_MODEL=claude-sonnet-4-6
FOSSILRAG_LLM_MAX_TOKENS=1024
FOSSILRAG_LLM_TEMPERATURE=0.2
FOSSILRAG_BEDROCK_PROMPT_CACHE=true

# --- Prompt Fossilization (prompt/output cache) ----------------------------
# memory (default, per-process) | local (JSON file) | dynamodb (shared, TTL).
FOSSILRAG_PROMPT_CACHE_BACKEND=memory
# FOSSILRAG_PROMPT_CACHE_TABLE=fossilrag-prompt-cache  # required for dynamodb
FOSSILRAG_PROMPT_CACHE_PATH=./.fossilrag/prompt_cache.json

# --- Service ---------------------------------------------------------------
FOSSILRAG_LOG_LEVEL=INFO
# Optional API-key auth. Leave UNSET for local/demo (open). When set, every
# endpoint except / and /healthz requires a matching X-API-Key header.
# FOSSILRAG_API_KEY=
