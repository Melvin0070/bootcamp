# CloudFormation parameter overrides for activity-04-cloudformation-cost
#
# Usage:
#   aws cloudformation deploy \
#     --template-file template.yaml \
#     --stack-name web-stack-dev \
#     --capabilities CAPABILITY_IAM CAPABILITY_NAMED_IAM \
#     --parameter-overrides \
#       Environment=$ENVIRONMENT \
#       InstanceType=$INSTANCE_TYPE \
#       MinSize=$MIN_SIZE \
#       MaxSize=$MAX_SIZE \
#       DesiredCapacity=$DESIRED_CAPACITY \
#       VpcId=$VPC_ID \
#       SubnetIds=$SUBNET_IDS \
#       OwnerEmail=$OWNER_EMAIL

# ---- Deployment environment -----------------------------------------------
# dev | staging | prod
ENVIRONMENT=dev

# ---- Instance sizing -------------------------------------------------------
# Allowed: t3.micro | t3.small | t3.medium | t3.large | t3.xlarge
# Do NOT use m5.4xlarge — see docs/architecture.md for cost breakdown
INSTANCE_TYPE=t3.medium

# ---- Auto Scaling limits ---------------------------------------------------
# MinSize=0 enables scale-to-zero overnight (combined with ScheduledScaleDown)
MIN_SIZE=0
MAX_SIZE=4
DESIRED_CAPACITY=1

# ---- Network ---------------------------------------------------------------
# Replace with real VPC/subnet IDs from your AWS account
# Find yours: aws ec2 describe-vpcs --query "Vpcs[?IsDefault].VpcId" --output text
VPC_ID=vpc-xxxxxxxx
# Comma-separated list of at least two subnet IDs across different AZs
# Find yours: aws ec2 describe-subnets --filters "Name=defaultForAz,Values=true" --query "Subnets[].SubnetId"
SUBNET_IDS=subnet-xxxxxxxx,subnet-yyyyyyyy

# ---- Ownership / cost attribution -----------------------------------------
OWNER_EMAIL=team@example.com
