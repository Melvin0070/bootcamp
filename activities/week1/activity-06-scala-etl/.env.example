# Input / output paths for the Parquet ETL.
# Production points at S3; local dev uses filesystem paths.
INPUT_PATH=s3://fossilrag-raw/specimens/
OUTPUT_PATH=s3://fossilrag-enriched/specimens/

# Spark application name (visible in the Spark UI)
APP_NAME=SpecimenETL

# Spark master URL.
#   local[*]                  — all local cores (dev)
#   yarn                      — YARN cluster (prod EMR)
#   k8s://https://kube...     — Kubernetes cluster (prod EKS)
#   spark://master:7077       — standalone
SPARK_MASTER=local[*]

# Log level for Spark internals. The ETL's own SLF4J logger emits key=value
# structured records independently of this setting.
#   WARN  — recommended; silences Spark's INFO noise
#   INFO  — useful for deep debugging
#   ERROR — minimum; only failures surfaced
LOG_LEVEL=WARN
