# S3 (or local) path to the silver layer produced by the chunking pipeline
SILVER_PATH=s3://your-bucket/silver/chunks/

# S3 (or local) path where the gold layer will be written
GOLD_PATH=s3://your-bucket/gold/chunks/

# Write strategy: "delta" (requires delta-spark, recommended for production)
#                 "parquet" (no extra deps, good for local dev / Glue)
WRITE_FORMAT=delta
