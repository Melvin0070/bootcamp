# Lambda function ARNs — required, no defaults
EXTRACT_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:fossil-extractor
TRANSFORM_LAMBDA_ARN=arn:aws:lambda:us-east-1:123456789012:function:fossil-transformer

# Alert channels — both optional; omit to disable that channel
# Format: https://hooks.slack.com/services/<WORKSPACE_ID>/<CHANNEL_ID>/<SECRET_TOKEN>
SLACK_WEBHOOK_URL=PASTE_YOUR_SLACK_INCOMING_WEBHOOK_URL_HERE
ALERT_EMAIL=oncall@example.com

# SMTP settings (only needed if ALERT_EMAIL is set)
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# AWS config
AWS_REGION=us-east-1

# Lambda max timeout in seconds (default: 900 = 15 min).
# Airflow execution_timeout is set to this value + 60s buffer.
LAMBDA_TIMEOUT_SECONDS=900

# Airflow connection string for AWS (used by Airflow's AWS providers)
AIRFLOW_CONN_AWS_DEFAULT=aws:///?region_name=us-east-1
