# Activity 8 — embedding pipeline config.

# Path to the JSONL file with one chunk dict per line.
# Required keys: text. Optional: source, section, chunk_index.
CHUNKS_PATH=/data/fossilrag/chunks.jsonl

# Where successful embeddings are written (LocalSink) — overridden if you
# swap in S3Sink at the call site.
OUTPUT_DIR=/data/fossilrag/embeddings

# OpenAI model. text-embedding-3-small is the cost-effective default
# ($0.02/1M tokens). Use text-embedding-3-large for higher recall at 6.5×
# the cost.
EMBEDDING_MODEL=text-embedding-3-small

# How many chunks to bundle into one OpenAI API call. 64 is a good balance
# of throughput and rate-limit headroom for text-embedding-3-small.
BATCH_SIZE=64

# Idempotency backend: dynamodb | s3 | local
IDEMPOTENCY_BACKEND=local

# DynamoDB backend (production)
# Required when IDEMPOTENCY_BACKEND=dynamodb. The table must have a single
# String partition key named `chunk_id` and TTL enabled on the `ttl` field.
IDEMPOTENCY_TABLE=fossilrag-chunk-registry
AWS_REGION=us-east-1

# S3 manifest backend (single-writer batch jobs)
# Required when IDEMPOTENCY_BACKEND=s3.
MANIFEST_BUCKET=fossilrag-manifests
MANIFEST_KEY=embeddings/manifest.json

# Local backend (dev / tests)
# Required when IDEMPOTENCY_BACKEND=local.
MANIFEST_PATH=./manifest.json

# OpenAI API key — see Activity 9 for production-grade secrets handling.
OPENAI_API_KEY=

LOG_LEVEL=INFO
