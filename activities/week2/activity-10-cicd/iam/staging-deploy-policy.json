{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PutAndReadStagingArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:GetObject",
        "s3:GetObjectAttributes"
      ],
      "Resource": "arn:aws:s3:::fossilrag-staging-deploy/*"
    },
    {
      "Sid": "HeadStagingBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::fossilrag-staging-deploy"
    }
  ]
}
