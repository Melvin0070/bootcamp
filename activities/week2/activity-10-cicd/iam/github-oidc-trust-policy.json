{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubOIDCAssumeRoleForStagingDeploy",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:Melvin0070/bootcamp:environment:staging"
        }
      }
    }
  ]
}
