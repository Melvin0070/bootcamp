# Activity 10 — local development overrides.
# These variables are read by pipeline.py when run outside CI. The
# real values live in environment-scoped GitHub Secrets and are
# injected only when the deploy workflow runs.

# AWS region for boto3 clients. Defaults to us-east-1.
AWS_REGION=us-east-1

# Python logging level. INFO in CI; DEBUG locally if you want
# every event= line including the read_csv/write_parquet calls.
LOG_LEVEL=INFO

# Staging bucket. Used by `python pipeline.py --bucket ...` for
# local end-to-end runs against an LocalStack-stubbed S3.
STAGING_BUCKET=fossilrag-staging-deploy
