# Activity 9 — local dev secrets.
#
# Copy this file to `.env` (which is gitignored) and fill in real values.
# In production, leave these unset and let `secrets_manager.get_secret(...)`
# fall back to AWS Secrets Manager via the IAM role attached to the
# task / instance / Lambda.
#
# Never commit a `.env` with real values. The pre-commit hook will refuse
# to let you, but social-engineering still works on humans.

# ----- Secrets (resolved by secrets_manager.get_secret) -----
# Leave blank to force resolution from AWS Secrets Manager.
OPENAI_API_KEY=
DATABASE_URL=

# ----- Non-secret runtime config -----
AWS_REGION=us-east-1
S3_BUCKET=fossilrag-dev
SECRETS_PREFIX=fossilrag/dev

# ----- Observability knobs -----
LOG_LEVEL=INFO

# Set to 1 to log a *redacted* probe of every resolved secret (first 4 chars
# only) — handy when debugging "why is this key the wrong one".
LOG_SECRET_PROBE=0
