# Activity 7 — vector search service config.
# Copy to `.env` and `source` it (or use python-dotenv) before running.

# Path to the .npy file holding (N, dim) float32 embeddings.
# Local dev:  ./fixtures/embeddings.npy
# Prod (S3 mounted via Mountpoint or Goofys): /mnt/fossilrag/embeddings.npy
EMBEDDINGS_PATH=/data/fossilrag/embeddings.npy

# Hugging Face model id used to encode the query at request time.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# How often (seconds) the background task checks for embeddings file changes.
# Set to a large value (e.g. 3600) to disable polling and rely on /refresh + SIGHUP.
REFRESH_INTERVAL_SEC=60

# Index kind: flat_ip (default, exact, <=1M), hnsw (ANN, 1-50M), ivf_pq (>=50M).
INDEX_KIND=flat_ip

# Python logging level for the service. Spark's own log level is independent.
LOG_LEVEL=INFO
